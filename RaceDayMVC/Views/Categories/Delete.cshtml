@model RaceDayMVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">

    <h2>Delete Event Category</h2>

    <div class="alert alert-warning">
        <strong>Warning!</strong>
        Are you sure you want to delete this category?
        This action cannot be undone.
    </div>

    <p class="text-muted">
        Please review the category details before deleting.
    </p>

    <div class="card mb-4">
        <div class="card-body">

            <h4>@Model.CategoryName</h4>

            <hr />

            <p>
                <strong>Category ID:</strong>
                @Model.CategoryId
            </p>

            <p>
                <strong>Category Name:</strong>
                @Model.CategoryName
            </p>

            <p>
                <strong>Description:</strong>
                @Model.Description
            </p>

            <p>
                <strong>Event ID:</strong>
                @Model.EventId
            </p>

        </div>
    </div>

    <form asp-controller="Categories"
          asp-action="DeleteConfirmed"
          asp-route-id="@Model.CategoryId"
          asp-route-eventId="@Model.EventId"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Yes, Delete Category
        </button>

        <a asp-controller="Categories"
           asp-action="Index"
           asp-route-eventId="@Model.EventId"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

