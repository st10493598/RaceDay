@model RaceDayMVC.Models.OrganiserDashboardViewModel

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">

    <!-- Dashboard Heading -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="text-primary">Organiser Dashboard</h2>

            <p class="lead">
                Welcome, @ViewBag.FirstName!
            </p>

            <div class="alert alert-success">
                You are successfully logged in as an Organiser.
            </div>

            <p>
                Manage your RaceDay events, monitor participant
                enrolments, and capture race results.
            </p>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Error Message -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <!-- Dashboard Statistics -->
    <h4 class="mb-3">Dashboard Overview</h4>

    <div class="row g-3 mb-4">

        <!-- Total Events -->
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow-sm h-100">
                <div class="card-body text-center">
                    <h5>Total Events</h5>

                    <h1 class="display-4">
                        @Model.TotalEvents
                    </h1>

                    <p class="mb-0">
                        Events you have created
                    </p>
                </div>
            </div>
        </div>

        <!-- Total Enrolments -->
        <div class="col-md-4">
            <div class="card text-white bg-success shadow-sm h-100">
                <div class="card-body text-center">
                    <h5>Total Enrolments</h5>

                    <h1 class="display-4">
                        @Model.TotalEnrolments
                    </h1>

                    <p class="mb-0">
                        Participant registrations
                    </p>
                </div>
            </div>
        </div>

        <!-- Upcoming Events -->
        <div class="col-md-4">
            <div class="card text-dark bg-warning shadow-sm h-100">
                <div class="card-body text-center">
                    <h5>Upcoming Events</h5>

                    <h1 class="display-4">
                        @Model.UpcomingEvents
                    </h1>

                    <p class="mb-0">
                        Events scheduled from today onwards
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Organiser Events -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">My Events Overview</h5>
        </div>

        <div class="card-body">

            @if (Model.Events == null || !Model.Events.Any())
            {
                <div class="alert alert-info">
                    You have not created any events yet.
                </div>

                <a asp-controller="Events"
                   asp-action="Create"
                   class="btn btn-primary">
                    Create Your First Event
                </a>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Event Name</th>
                                <th>Event Date</th>
                                <th>Location</th>
                                <th>Enrolments</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var evt in Model.Events)
                            {
                                bool isUpcoming =
                                    evt.EventDate.Date >= DateTime.Today;

                                <tr>
                                    <td>
                                        <strong>@evt.EventName</strong>
                                    </td>

                                    <td>
                                        @evt.EventDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @evt.Location
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @evt.TotalEnrolments
                                        </span>
                                    </td>

                                    <td>
                                        @if (isUpcoming)
                                        {
                                            <span class="badge bg-success">
                                                Upcoming
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Completed
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-1">

                                            <!-- Edit Event -->
                                            <a asp-controller="Events"
                                               asp-action="Edit"
                                               asp-route-id="@evt.EventId"
                                               class="btn btn-sm btn-primary">
                                                Edit Event
                                            </a>

                                            <!-- NEW: Upload Event Banner -->
                                            <a asp-controller="Organiser"
                                               asp-action="UploadEventBanner"
                                               asp-route-eventId="@evt.EventId"
                                               class="btn btn-sm btn-info text-white">
                                                Upload Banner
                                            </a>

                                            <!-- Capture Results -->
                                            <a asp-controller="Organiser"
                                               asp-action="CaptureResult"
                                               asp-route-eventId="@evt.EventId"
                                               class="btn btn-sm btn-warning">
                                                Capture Results
                                            </a>

                                            <!-- Manage Results -->
                                            <a asp-controller="Organiser"
                                               asp-action="ManageResults"
                                               asp-route-eventId="@evt.EventId"
                                               class="btn btn-sm btn-success">
                                                Manage Results
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>

    <!-- Organiser Features -->
    <h4 class="mb-3">Organiser Features</h4>

    <div class="row g-3 mb-4">

        <!-- Event Management -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title text-primary">
                        Event Management
                    </h5>

                    <p class="card-text">
                        Create, view, update and manage
                        your RaceDay events.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="Events"
                           asp-action="Index"
                           class="btn btn-primary">
                            Manage Events
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Enrolment Management -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title text-primary">
                        Enrolment Management
                    </h5>

                    <p class="card-text">
                        View participant registrations
                        and manage enrolment statuses.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="Events"
                           asp-action="Index"
                           class="btn btn-success">
                            Select Event
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Capture Results -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title text-primary">
                        Capture Race Results
                    </h5>

                    <p class="card-text">
                        Record finishing times, chip times,
                        positions and race statuses.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="Events"
                           asp-action="Index"
                           class="btn btn-warning">
                            Select Event
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <!-- Manage Results -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title text-primary">
                        Manage Race Results
                    </h5>

                    <p class="card-text">
                        View and update previously
                        captured race results.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="Events"
                           asp-action="Index"
                           class="btn btn-success">
                            Select Event
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>

</div>