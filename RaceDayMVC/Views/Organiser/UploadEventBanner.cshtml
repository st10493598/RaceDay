@{
    ViewData["Title"] = "Upload Event Banner";
    int eventId = (int)(ViewBag.EventId ?? 0);
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Upload Event Banner</h3>
        </div>

        <div class="card-body">
            <p>Select a banner image for your event.</p>
            <p class="text-muted">
                Supported formats: JPG, PNG, WebP. Maximum size: 5 MB.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Organiser"
                  asp-action="UploadEventBanner"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="eventId"
                       value="@eventId" />

                <div class="mb-3">
                    <label for="image" class="form-label">
                        Choose Event Banner
                    </label>

                    <input type="file"
                           id="image"
                           name="image"
                           class="form-control"
                           accept="image/jpeg,image/png,image/webp"
                           required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Upload Banner
                    </button>

                    <a asp-controller="Organiser"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>