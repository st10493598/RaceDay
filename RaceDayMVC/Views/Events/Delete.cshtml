@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-4">

    <h2>Delete Event</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this event?
        This action cannot be undone.
    </div>

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="card mb-4">
        <div class="card-body">

            <h4>@Model.EventName</h4>

            <p>
                <strong>Date:</strong>
                @Model.EventDate.ToString("dd MMM yyyy")
            </p>

            <p>
                <strong>Location:</strong>
                @Model.Location
            </p>

            <p>
                <strong>Distance:</strong>
                @Model.Distance.ToString("0.##") km
            </p>

            <p>
                <strong>Event Type:</strong>
                @Model.EventType
            </p>

        </div>
    </div>

    <form asp-controller="Events"
          asp-action="DeleteConfirmed"
          asp-route-id="@Model.EventId"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Yes, Delete Event
        </button>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

