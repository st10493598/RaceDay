@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">

    <h2>Manage Events</h2>

    <p class="text-muted">
        View and manage events available in the RaceDay system.
    </p>

    <!-- Create Event Button -->
    <div class="mb-3">
        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-primary">
            + Create New Event
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- API Error -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }
    else if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            No events are available yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Event Banner</th>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Event Type</th>
                        <th>Organiser</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var evt in Model)
                    {
                        <tr>

                            <!-- Event Banner -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(evt.BannerImageUrl))
                                {
                                    <img src="@evt.BannerImageUrl"
                                         alt="Banner for @evt.EventName"
                                         class="img-thumbnail"
                                         style="width: 140px;
                                    height: 90px;
                                    object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No banner uploaded
                                    </span>
                                }
                            </td>

                            <!-- Event Name -->
                            <td>
                                @evt.EventName
                            </td>

                            <!-- Event Date -->
                            <td>
                                @evt.EventDate.ToString("dd MMM yyyy")
                            </td>

                            <!-- Location -->
                            <td>
                                @evt.Location
                            </td>

                            <!-- Distance -->
                            <td>
                                @evt.Distance.ToString("0.##") km
                            </td>

                            <!-- Event Type -->
                            <td>
                                @evt.EventType
                            </td>

                            <!-- Organiser -->
                            <td>
                                @evt.OrganiserName
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    <!-- Edit Event -->
                                    <a asp-controller="Events"
                                       asp-action="Edit"
                                       asp-route-id="@evt.EventId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <!-- Manage Categories -->
                                    <a asp-controller="Categories"
                                       asp-action="Index"
                                       asp-route-eventId="@evt.EventId"
                                       class="btn btn-info btn-sm">
                                        Categories
                                    </a>

                                    <!-- View Enrolments -->
                                    <a asp-controller="Enrolments"
                                       asp-action="Index"
                                       asp-route-eventId="@evt.EventId"
                                       class="btn btn-success btn-sm">
                                        Enrolments
                                    </a>

                                    <!-- Delete Event -->
                                    <a asp-controller="Events"
                                       asp-action="Delete"
                                       asp-route-id="@evt.EventId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>