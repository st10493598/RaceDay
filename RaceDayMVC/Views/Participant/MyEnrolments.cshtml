@model List<RaceDayMVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">

    <h2 class="text-primary mb-3">
        My Enrolments
    </h2>

    <p class="text-muted">
        View your registered RaceDay events and
        track your enrolment statuses.
    </p>

    <div class="mb-3">
        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

        <a asp-controller="Participant"
           asp-action="BrowseEvents"
           class="btn btn-primary">
            Browse More Events
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }
    else if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not registered for any events yet.
        </div>
    }
    else
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-body">

                <h5 class="card-title">
                    My Registration Summary
                </h5>

                <p class="mb-0">
                    <strong>Total Enrolments:</strong>
                    @Model.Count
                </p>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-striped table-bordered align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Event Date</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>
                                @enrolment.EventName
                            </td>

                            <td>
                                @if (enrolment.EventDate.HasValue)
                                {
                                    @enrolment.EventDate.Value.ToString("dd MMM yyyy")
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </td>

                            <td>
                                @enrolment.CategoryName
                            </td>

                            <td>
                                @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (enrolment.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else if (enrolment.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (enrolment.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @enrolment.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>