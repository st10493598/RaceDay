@model RaceDayMVC.Models.ParticipantProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary">🏃 My RaceDay Profile</h1>
        <p class="text-muted">
            Manage your personal information and profile picture.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body text-center p-4">

                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                    {
                        <img src="@Model.ProfilePictureUrl"
                             alt="Profile Picture"
                             class="rounded-circle border border-3 border-primary mb-3"
                             style="width:150px;height:150px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light border
                            d-flex align-items-center justify-content-center
                            mx-auto mb-3"
                             style="width:150px;height:150px;font-size:65px;">
                            👤
                        </div>
                    }

                    <h3 class="fw-bold">
                        @Model.FirstName @Model.LastName
                    </h3>

                    <p class="text-muted">@Model.Email</p>

                    <span class="badge bg-success">
                        Participant
                    </span>

                    <hr class="my-4" />

                    <h5 class="fw-bold mb-3">
                        Upload Profile Picture
                    </h5>

                    <form asp-controller="Participant"
                          asp-action="UploadProfilePicture"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <input type="file"
                                   name="image"
                                   accept="image/jpeg,image/png,image/webp"
                                   class="form-control"
                                   required />
                        </div>

                        <p class="small text-muted">
                            JPG, PNG or WebP. Maximum size: 5 MB.
                        </p>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            📷 Upload Picture
                        </button>

                    </form>

                </div>

            </div>

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">✏️ Edit Personal Information</h4>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Participant"
                          asp-action="Profile"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Role" type="hidden" />
                        <input asp-for="ProfilePictureUrl" type="hidden" />

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName"
                                       class="form-label fw-semibold"></label>

                                <input asp-for="FirstName"
                                       class="form-control" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName"
                                       class="form-label fw-semibold"></label>

                                <input asp-for="LastName"
                                       class="form-control" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DateOfBirth"
                                       class="form-label fw-semibold"></label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Gender"
                                       class="form-label fw-semibold"></label>

                                <select asp-for="Gender"
                                        class="form-select">
                                    <option value="">Select Gender</option>
                                    <option value="Female">Female</option>
                                    <option value="Male">Male</option>
                                    <option value="Other">Other</option>
                                    <option value="Prefer not to say">
                                        Prefer not to say
                                    </option>
                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="ContactNumber"
                                       class="form-label fw-semibold"></label>

                                <input asp-for="ContactNumber"
                                       class="form-control"
                                       placeholder="Enter your contact number" />

                                <span asp-validation-for="ContactNumber"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <div class="d-grid mt-3">

                            <button type="submit"
                                    class="btn btn-success btn-lg">
                                💾 Save Profile Changes
                            </button>

                        </div>

                    </form>

                </div>

            </div>

            <div class="text-center mt-4">

                <a asp-controller="Participant"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    ← Back to Dashboard
                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}